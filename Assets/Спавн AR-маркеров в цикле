using UnityEngine;

 public class Task1_SpawnMarkers : MonoBehaviour
    {
        public GameObject markerPrefab;

        void Start()
        {
            for (int i = 0; i < 5; i++)
            {
                GameObject spawnedMarker = Instantiate(markerPrefab, new Vector3(i * 2, 0, 0), Quaternion.identity);
                Debug.Log("Создан объект: " + spawnedMarker.name);
            }
        }
    }
